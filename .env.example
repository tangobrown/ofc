# Behold Instagram feed id — powers the "The Latest on Instagram" section.
# Create a feed at https://behold.so, then copy its feed id here.
# The feed is fetched server-side from https://feeds.behold.so/<id>.
# Leave unset to hide the Instagram section entirely (no error, no gap).
BEHOLD_FEED_ID=

# Canonical production origin used for SEO (canonical URLs, Open Graph, sitemap,
# robots). Set this to the deployed domain. Defaults to the client's domain.
NEXT_PUBLIC_SITE_URL=https://theoldfashionedcocktailco.com
